# Скопируй в .env и заполни
BOT_TOKEN=123456789:AAF...вставь_токен_от_BotFather
ADMIN_IDS=123456789

# Опционально
DB_PATH=linktree.db
LOG_LEVEL=INFO

# Поисковый бэкенд: auto | local | st | api
#   local — офлайн-гибрид (по умолчанию, внешних зависимостей нет)
#   st    — sentence-transformers (pip install sentence-transformers)
#   api   — OpenAI-совместимый /embeddings (Ollama, LM Studio, vLLM, OpenAI)
SEARCH_BACKEND=auto
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_API_BASE=http://localhost:11434/v1
# EMBEDDING_API_KEY=

RESULTS_PER_PAGE=3
DIGEST_HOUR=10
